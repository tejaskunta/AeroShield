# --- datasets & weights: never commit these to git -------------------------
# Datasets are huge and often licensed.
# Weights are build artifacts and should be versioned via releases/artifacts.
datasets/
runs/
weights/
*.pt
*.onnx
*.engine
*.trt
!yolov8n.pt.placeholder

# Ultralytics drops pretrained checkpoints in the working dir on first run
yolov8*.pt
yolo11*.pt

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# virtualenvs
.venv*/
venv*/
env*/
ENV*/
backend/venv*/

# --- tooling ---------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# --- experiment tracking ---------------------------------------------------
wandb/
mlruns/
lightning_logs/
events.out.tfevents.*

# --- editors & OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- secrets ---------------------------------------------------------------
.env
.env.*
!.env.example
backend/.env
*.key
*.pem

# --- jetson build logs -----------------------------------------------------
jetson/build_engine.log

# --- jetson runtime artifacts (Week 4) -------------------------------------
# Offline uplink spool: detections captured while the radio link was down. Real
# mission data, and potentially large - belongs on the drone, not in git.
jetson/spool/
# Local detection log written by live_detect.py (the fallback record of a flight).
jetson/logs/

# --- backend runtime artifacts (Week 5) ------------------------------------
# Uploaded detection frames. Thousands of JPEGs per mission.
backend/storage/

