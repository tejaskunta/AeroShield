# AeroShield backend configuration.
#
#   cp .env.example .env
#
# .env is gitignored (see ../.gitignore); this template is not. Never put a real
# key in this file.
#
# Every variable is prefixed AEROSHIELD_ so it cannot collide with something else
# in the environment - notably PATH-adjacent names like DATABASE_URL, which half
# the tools on a developer machine also read.

# --- database ----------------------------------------------------------------
# Must be the asyncpg driver: postgresql+asyncpg://, not postgresql://.
# Host is `localhost` when Postgres runs via docker-compose and the API runs on
# the host. It becomes `db` only if you also containerise the API.
AEROSHIELD_DATABASE_URL=postgresql+asyncpg://aeroshield:aeroshield_dev@localhost:5432/aeroshield

# Separate database for pytest - the suite creates and drops tables, so pointing
# this at the development database would wipe your data on every test run.
AEROSHIELD_TEST_DATABASE_URL=postgresql+asyncpg://aeroshield:aeroshield_dev@localhost:5432/aeroshield_test

# Log every SQL statement. Useful when a PostGIS query misbehaves, deafening otherwise.
AEROSHIELD_DB_ECHO=false

# --- app ---------------------------------------------------------------------
AEROSHIELD_ENV=development
AEROSHIELD_DEBUG=true

# Where uploaded detection frames are written. Relative paths resolve against the
# backend/ directory. Gitignored.
AEROSHIELD_STORAGE_DIR=storage

# Reject uploads above this size, in megabytes. A 720p JPEG is well under 1 MB;
# this is a guard against a misconfigured client streaming video at the endpoint.
AEROSHIELD_MAX_IMAGE_MB=12

# --- CORS --------------------------------------------------------------------
# The Week 6 React dev server. Comma-separated. Do NOT use "*" once real API keys
# are in play - a wildcard origin plus a browser-held key is how a key leaks.
AEROSHIELD_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# --- pagination --------------------------------------------------------------
AEROSHIELD_DEFAULT_PAGE_SIZE=50
AEROSHIELD_MAX_PAGE_SIZE=500

# --- API keys ----------------------------------------------------------------
# Mint keys with:  python scripts/create_api_key.py --name drone-01 --scopes drone:ingest
#
# Optional bootstrap key, read at startup and upserted as an admin key. Convenient
# for a fresh clone or a CI run; leave it EMPTY in any real deployment and use the
# CLI instead, because anything in an env file tends to end up in a shell history
# or a screenshot.
AEROSHIELD_BOOTSTRAP_ADMIN_KEY=

# --- intelligence layer (PRD 5.1) ---------------------------------------------
# Every AI feature degrades to a deterministic offline answer when its key or
# dependency is missing, so a classroom demo with zero keys and zero network
# still works. The mode is REPORTED in responses (`grounded`, `engine`,
# `renderer`) rather than hidden - leave these empty on purpose for a demo.

# Groq serves the Llama-3-class model behind the copilot and the report narrative.
# Empty key => no LLM call is ever attempted; the copilot answers extractively from
# the retrieved passages and reports stay on the template engine.
AEROSHIELD_GROQ_API_KEY=
AEROSHIELD_GROQ_MODEL=llama-3.3-70b-versatile
AEROSHIELD_GROQ_BASE_URL=https://api.groq.com/openai/v1
AEROSHIELD_LLM_TIMEOUT_S=20

# Chroma persistent store for the copilot corpus. When chromadb is not installed
# (or this dir is unwritable), retrieval falls back to a deterministic lexical
# scorer over the same chunks - same citations, different ranking engine.
AEROSHIELD_CHROMA_DIR=chroma
AEROSHIELD_COPILOT_TOP_K=4
AEROSHIELD_COPILOT_MIN_SCORE=0.08

# Where generated mission reports (PDF or HTML + JSON sidecar) are written.
# Relative paths resolve against backend/. Gitignored.
AEROSHIELD_REPORTS_DIR=storage/reports
