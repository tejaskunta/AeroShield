    "three": "0.169.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
